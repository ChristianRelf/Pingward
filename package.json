{
  "name": "pingward",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch scripts/dev.js",
    "build": "vite build",
    "docker:up": "bash scripts/up.sh",
    "start": "node server/index.js",
    "test": "node --test server/*.test.js scripts/*.test.js",

# Source installs:
PORT=3000
DATA_DIR=./data
# Docker Compose host binding. The launcher scans upward from 3000 automatically.
# PINGWARD_BIND_ADDRESS=127.0.0.1
# PINGWARD_HOST_PORT=3000
# Optional: set when running behind a reverse proxy that forwards HTTPS.
# TRUST_PROXY=1
# Recommended before exposing a fresh install to the internet. Remove after setup.
# SETUP_TOKEN=replace-with-a-long-random-value

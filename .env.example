# Source installs:
PORT=3000
DATA_DIR=./data
# The installer writes these Docker Compose values after a successful launch.
# PINGWARD_BIND_ADDRESS=127.0.0.1
# PINGWARD_HOST_PORT=3000
# Optional: set when running behind a reverse proxy that forwards HTTPS.
# TRUST_PROXY=1
# The installer creates this automatically; set it yourself to use a custom token.
# SETUP_TOKEN=replace-with-a-long-random-value
